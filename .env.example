APP_NAME=Paralegal Voice Agents API
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# For local development, Docker Compose exposes MongoDB at this address.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=paralegal_voice_agents

# Firm operating profile. Use comma-separated values for jurisdictions.
FIRM_NAME=Victus Family Law Firm
FIRM_PRIMARY_PHONE=
FIRM_OFFICE_TIMEZONE=Asia/Kolkata
FIRM_OFFICE_HOURS=Monday-Friday 09:30-18:30
FIRM_SUPPORTED_JURISDICTIONS=India
AFTER_HOURS_AGENT_ENABLED=true
CALLBACK_TARGET_BUSINESS_HOURS=1

# Providers. Exotel and Sarvam are selected for the demo; storage is pending.
TELEPHONY_PROVIDER=exotel
SPEECH_TO_TEXT_PROVIDER=sarvam
TEXT_TO_SPEECH_PROVIDER=sarvam
OBJECT_STORAGE_PROVIDER=unconfigured

# Provider credentials. Keep real values only in .env.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_API_BASE_URL=https://api.in.exotel.com
SARVAM_API_KEY=

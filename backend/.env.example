APP_NAME=Paralegal Voice Agents API
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# For local development, Docker Compose exposes MongoDB at this address.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=paralegal_voice_agents
# Optional: additional databases holding historical intake calls. Keep the portal-user
# database above unchanged; names are case-sensitive and calls stay in place.
PORTAL_CALL_DATABASES=

# Firm operating profile. Use comma-separated values for jurisdictions.
FIRM_NAME=Victus Family Law Firm
FIRM_PRIMARY_PHONE=
FIRM_OFFICE_TIMEZONE=Asia/Kolkata
FIRM_OFFICE_HOURS=Monday-Friday 09:30-18:30
FIRM_SUPPORTED_JURISDICTIONS=India
AFTER_HOURS_AGENT_ENABLED=true
CALLBACK_TARGET_BUSINESS_HOURS=1

# Providers. Exotel (telephony) and Sarvam (speech and chat) are selected for the demo.
SPEECH_TO_TEXT_PROVIDER=sarvam
TEXT_TO_SPEECH_PROVIDER=sarvam
OBJECT_STORAGE_PROVIDER=unconfigured

# Provider credentials. Keep real values only in .env.
EXOTEL_WEBHOOK_TOKEN=
PUBLIC_BASE_URL=
EXOTEL_VOICEBOT_USERNAME=
EXOTEL_VOICEBOT_PASSWORD=
SARVAM_API_KEY=
# Conversational model for the post-consent intake playbook.
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_CHAT_TIMEOUT_SECONDS=15
SARVAM_STT_LANGUAGE_CODE=auto
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_STREAM_TYPE=fast
# Exotel Voicebot audio is 8 kHz Linear16 by default.
SARVAM_STT_SAMPLE_RATE=8000
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_LANGUAGE_CODE=en-IN
SARVAM_TTS_SPEAKER=aparna_en_companion
SARVAM_TTS_HINDI_SPEAKER=aparna_hi_customer
SARVAM_TTS_SAMPLE_RATE=8000
VOICE_BARGE_IN_ENABLED=true
DEMO_BARGE_IN_ENABLED=false

# Private Google Cloud Storage for recordings and generated reports.
# Store the downloaded service-account JSON beneath ./secrets/ (gitignored).
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_SERVICE_ACCOUNT_KEY_PATH=secrets/gcs-storage.json
# For Cloud Run ADC without a key file, set this to the runtime service account email.
GCS_SIGNING_SERVICE_ACCOUNT_EMAIL=
GCS_SIGNED_URL_TTL_MINUTES=10

# Enables the local recording-review API for the separate front-end project.
# Never enable this on a public deployment.
LOCAL_REVIEW_API_ENABLED=false

# Generate with: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Named lawyer portal sessions. Generate a unique random value with at least 32 characters.
PORTAL_SESSION_SECRET=
